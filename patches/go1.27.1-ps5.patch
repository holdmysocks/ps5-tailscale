+// pipe2 is not implemented by the PS5 kernel, so build it from pipe and fcntl.
+func pipe2(flags int32) (r, w int32, errno int32) {
+	const (
+		_F_GETFL = 3
+		_F_SETFL = 4
+	)
+	r, w, errno = pipe()
+	if errno != 0 {
+		return -1, -1, errno
+	}
+	if flags&_O_CLOEXEC != 0 {
+		closeonexec(r)
+		closeonexec(w)
+	}
+	if flags&_O_NONBLOCK != 0 {
+		for _, fd := range [2]int32{r, w} {
+			if fl, e := fcntl(fd, _F_GETFL, 0); e == 0 {
+				fcntl(fd, _F_SETFL, fl|_O_NONBLOCK)
+			}
+		}
+	}
+	return r, w, 0
+}

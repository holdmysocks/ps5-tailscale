+// ps5Getrandom fills buf from the kernel's kern.arandom sysctl, which hands
+// out at most 256 bytes per call.
+func ps5Getrandom(buf []byte) (int, Errno) {
+	mib := [2]_C_int{1 /* CTL_KERN */, 37 /* KERN_ARND */}
+	for done := 0; done < len(buf); {
+		n := uintptr(len(buf) - done)
+		if n > 256 {
+			n = 256
+		}
+		_, _, e := rawSysDirect6(ps5SysSysctl, uintptr(unsafe.Pointer(&mib[0])), 2, uintptr(unsafe.Pointer(&buf[done])), uintptr(unsafe.Pointer(&n)), 0, 0)
+		if e != 0 {
+			return done, e
+		}
+		if n == 0 {
+			return done, EIO
+		}
+		done += int(n)
+	}
+	return len(buf), 0
+}
